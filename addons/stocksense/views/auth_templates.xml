<odoo>
    <template id="login_otp_link" inherit_id="web.login" name="StockSense: reset password with a code">
        <xpath expr="//label[@for='password']" position="inside">
            <a class="btn btn-link btn-sm" tabindex="1" t-attf-href="/stocksense/reset_password?{{ keep_query('login') }}">Forgot password?</a>
        </xpath>
    </template>

    <template id="reset_password_request" name="StockSense: request reset code">
        <t t-call="web.login_layout">
            <form class="oe_login_form" role="form" method="post" action="/stocksense/reset_password">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <h4 class="mb-2">Reset your password</h4>
                <p class="text-muted small">Enter your login email. We will send you a 6-digit code.</p>
                <div class="mb-3">
                    <label for="login" class="form-label">Email</label>
                    <input type="text" name="login" id="login" t-att-value="login" class="form-control" autocapitalize="off" autocomplete="username" autofocus="autofocus" required="required"/>
                </div>
                <div class="d-grid">
                    <button type="submit" class="btn btn-primary">Send code</button>
                    <a href="/web/login" class="btn btn-link btn-sm mt-2">Back to login</a>
                </div>
            </form>
        </t>
    </template>

    <template id="reset_password_verify" name="StockSense: enter reset code">
        <t t-call="web.login_layout">
            <form class="oe_login_form" role="form" method="post" action="/stocksense/reset_password/verify">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <input type="hidden" name="login" t-att-value="login"/>
                <h4 class="mb-2">Enter your code</h4>
                <p class="alert alert-success" t-if="message" role="status"><t t-esc="message"/></p>
                <p class="alert alert-danger" t-if="error" role="alert"><t t-esc="error"/></p>
                <div class="mb-3">
                    <label for="code" class="form-label">6-digit code</label>
                    <input type="text" name="code" id="code" class="form-control" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" autofocus="autofocus" required="required"/>
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label">New password</label>
                    <input type="password" name="password" id="password" class="form-control" minlength="8" autocomplete="new-password" required="required"/>
                </div>
                <div class="mb-3">
                    <label for="confirm_password" class="form-label">Confirm new password</label>
                    <input type="password" name="confirm_password" id="confirm_password" class="form-control" minlength="8" autocomplete="new-password" required="required"/>
                </div>
                <div class="d-grid">
                    <button type="submit" class="btn btn-primary">Reset password</button>
                </div>
            </form>
            <form role="form" method="post" action="/stocksense/reset_password" class="text-center">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <input type="hidden" name="login" t-att-value="login"/>
                <button type="submit" class="btn btn-link btn-sm">Didn't get a code? Send a new one</button>
                <a href="/web/login" class="btn btn-link btn-sm">Back to login</a>
            </form>
        </t>
    </template>
</odoo>
