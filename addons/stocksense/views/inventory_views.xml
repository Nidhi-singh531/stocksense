<odoo>
    <record id="product_list" model="ir.ui.view"><field name="name">stocksense.product.list</field><field name="model">stocksense.product</field><field name="arch" type="xml">
        <list><field name="sku"/><field name="name"/><field name="category_id"/><field name="unit_of_measure"/><field name="quantity_on_hand"/><field name="company_id" groups="base.group_multi_company"/></list>
    </field></record>
    <record id="product_form" model="ir.ui.view"><field name="name">stocksense.product.form</field><field name="model">stocksense.product</field><field name="arch" type="xml">
        <form><sheet><widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/><field name="active" invisible="1"/><div class="oe_title"><h1><field name="name" placeholder="Product name"/></h1></div><group><group><field name="sku"/><field name="category_id" options="{'no_open': True}"/><field name="unit_of_measure"/></group><group><field name="company_id" groups="base.group_multi_company"/><field name="quantity_on_hand" invisible="not id"/><field name="initial_quantity" invisible="id"/><field name="initial_location_id" invisible="id" required="initial_quantity" options="{'no_create': True}"/></group></group><div class="alert alert-info" role="status" invisible="not id">Receive, deliver, transfer or count this product through Operations. Every change is recorded in Move History.</div><div class="alert alert-info" role="status" invisible="id">Initial stock is optional. It is posted as an adjustment when you save.</div><field name="stock_ids" readonly="1" invisible="not id"><list create="0" delete="0"><field name="location_id"/><field name="quantity"/></list></field></sheet></form>
    </field></record>
    <record id="product_search" model="ir.ui.view"><field name="name">stocksense.product.search</field><field name="model">stocksense.product</field><field name="arch" type="xml"><search><field name="name" string="Product / SKU" filter_domain="['|', ('name', 'ilike', self), ('sku', 'ilike', self)]"/><field name="sku"/><field name="category_id"/><filter name="in_stock" string="In Stock" domain="[('stock_ids.quantity', '&gt;', 0)]"/><filter name="archived" string="Archived" domain="[('active','=',False)]"/><group expand="0" string="Group By"><filter name="category" string="Category" context="{'group_by':'category_id'}"/><filter name="uom" string="Unit of Measure" context="{'group_by':'unit_of_measure'}"/></group></search></field></record>
    <record id="warehouse_list" model="ir.ui.view"><field name="name">stocksense.warehouse.list</field><field name="model">stocksense.warehouse</field><field name="arch" type="xml"><list><field name="code"/><field name="name"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
    <record id="warehouse_form" model="ir.ui.view"><field name="name">stocksense.warehouse.form</field><field name="model">stocksense.warehouse</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="code"/><field name="company_id" groups="base.group_multi_company"/></group><separator string="Locations"/><field name="location_ids"><list editable="bottom"><field name="name"/></list></field></sheet></form></field></record>
    <record id="location_list" model="ir.ui.view"><field name="name">stocksense.location.list</field><field name="model">stocksense.location</field><field name="arch" type="xml"><list><field name="name"/><field name="warehouse_id"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
    <record id="location_form" model="ir.ui.view"><field name="name">stocksense.location.form</field><field name="model">stocksense.location</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="warehouse_id"/><field name="company_id" invisible="1"/></group></sheet></form></field></record>
    <record id="stock_list" model="ir.ui.view"><field name="name">stocksense.stock.list</field><field name="model">stocksense.stock</field><field name="arch" type="xml"><list create="0" edit="0" delete="0" decoration-danger="quantity == 0"><field name="product_id"/><field name="location_id"/><field name="quantity"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
    <record id="stock_search" model="ir.ui.view"><field name="name">stocksense.stock.search</field><field name="model">stocksense.stock</field><field name="arch" type="xml"><search><field name="product_id"/><field name="location_id"/><field name="location_id" string="Warehouse" filter_domain="[('location_id.warehouse_id', 'ilike', self)]"/><field name="product_id" string="Category" filter_domain="[('product_id.category_id', 'ilike', self)]"/><filter name="empty" string="Out of Stock" domain="[('quantity','=',0)]"/><group expand="0" string="Group By"><filter name="product" string="Product" context="{'group_by':'product_id'}"/><filter name="location" string="Location" context="{'group_by':'location_id'}"/></group></search></field></record>
    <record id="ledger_list" model="ir.ui.view"><field name="name">stocksense.ledger.list</field><field name="model">stocksense.stock.ledger</field><field name="arch" type="xml"><list create="0" edit="0" delete="0" decoration-danger="quantity_change &lt; 0" decoration-success="quantity_change &gt; 0"><field name="date"/><field name="operation_id"/><field name="operation_type"/><field name="product_id"/><field name="location_id"/><field name="quantity_before"/><field name="quantity_change"/><field name="quantity_after"/><field name="user_id"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
    <record id="ledger_search" model="ir.ui.view"><field name="name">stocksense.ledger.search</field><field name="model">stocksense.stock.ledger</field><field name="arch" type="xml"><search><field name="product_id"/><field name="operation_id"/><field name="location_id"/><field name="location_id" string="Warehouse" filter_domain="[('location_id.warehouse_id', 'ilike', self)]"/><field name="product_id" string="Category" filter_domain="[('product_id.category_id', 'ilike', self)]"/><filter name="receipts" string="Receipts" domain="[('operation_type','=','receipt')]"/><filter name="deliveries" string="Deliveries" domain="[('operation_type','=','delivery')]"/><filter name="transfers" string="Internal Transfers" domain="[('operation_type','=','transfer')]"/><filter name="adjustments" string="Adjustments" domain="[('operation_type','=','adjustment')]"/><separator/><filter name="date" string="Date" date="date"/><group expand="0" string="Group By"><filter name="product" string="Product" context="{'group_by':'product_id'}"/><filter name="location" string="Location" context="{'group_by':'location_id'}"/><filter name="type" string="Operation Type" context="{'group_by':'operation_type'}"/></group></search></field></record>
    <record id="reorder_list" model="ir.ui.view"><field name="name">stocksense.reorder.list</field><field name="model">stocksense.reorder.rule</field><field name="arch" type="xml"><list editable="bottom" decoration-warning="suggested_quantity &gt; 0"><field name="company_id" column_invisible="True"/><field name="product_id"/><field name="location_id"/><field name="minimum_quantity"/><field name="target_quantity"/><field name="quantity_on_hand"/><field name="suggested_quantity"/></list></field></record>
    <record id="category_list" model="ir.ui.view"><field name="name">stocksense.product.category.list</field><field name="model">stocksense.product.category</field><field name="arch" type="xml"><list editable="bottom"><field name="name"/><field name="product_count"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
    <record id="reorder_search" model="ir.ui.view"><field name="name">stocksense.reorder.search</field><field name="model">stocksense.reorder.rule</field><field name="arch" type="xml"><search><field name="product_id"/><field name="location_id"/><filter name="below_minimum" string="Below Minimum" domain="[('below_minimum', '=', True)]"/><group expand="0" string="Group By"><filter name="location" string="Location" context="{'group_by':'location_id'}"/></group></search></field></record>
    <record id="location_search" model="ir.ui.view"><field name="name">stocksense.location.search</field><field name="model">stocksense.location</field><field name="arch" type="xml"><search><field name="name"/><field name="warehouse_id"/><group expand="0" string="Group By"><filter name="warehouse" string="Warehouse" context="{'group_by':'warehouse_id'}"/></group></search></field></record>
    <record id="action_categories" model="ir.actions.act_window"><field name="name">Product Categories</field><field name="res_model">stocksense.product.category</field><field name="view_mode">list</field></record>
    <record id="action_products" model="ir.actions.act_window"><field name="name">Products</field><field name="res_model">stocksense.product</field><field name="view_mode">list,form</field><field name="help" type="html"><p class="o_view_nocontent_smiling_face">Add your first product</p><p>Give it a unique SKU, then record opening quantities with an adjustment.</p></field></record>
    <record id="action_warehouses" model="ir.actions.act_window"><field name="name">Warehouses</field><field name="res_model">stocksense.warehouse</field><field name="view_mode">list,form</field></record>
    <record id="action_locations" model="ir.actions.act_window"><field name="name">Locations</field><field name="res_model">stocksense.location</field><field name="view_mode">list,form</field></record>
    <record id="action_stock" model="ir.actions.act_window"><field name="name">Stock on Hand</field><field name="res_model">stocksense.stock</field><field name="view_mode">list</field></record>
    <record id="action_ledger" model="ir.actions.act_window"><field name="name">Move History</field><field name="res_model">stocksense.stock.ledger</field><field name="view_mode">list</field></record>
    <record id="action_reorder" model="ir.actions.act_window"><field name="name">Reordering Rules</field><field name="res_model">stocksense.reorder.rule</field><field name="view_mode">list</field><field name="help" type="html"><p class="o_view_nocontent_smiling_face">Set a minimum for a product at a location</p><p>StockSense flags it on the dashboard when stock falls below the minimum and suggests how much to reorder.</p></field></record>
</odoo>
