<odoo>
    <data noupdate="1">
        <!-- Copied for every self sign-up: an internal user who lands on the dashboard. -->
        <record id="signup_template_user" model="res.users">
            <field name="name">StockSense Sign-up Template</field>
            <field name="login">stocksense.signup.template</field>
            <field name="active" eval="False"/>
            <field name="groups_id" eval="[(6, 0, [ref('base.group_user')])]"/>
            <field name="action_id" ref="stocksense.action_dashboard"/>
        </record>
        <function model="ir.config_parameter" name="set_param" eval="('auth_signup.invitation_scope', 'b2c')"/>
        <!-- The OTP flow replaces Odoo's emailed reset link. -->
        <function model="ir.config_parameter" name="set_param" eval="('auth_signup.reset_password', 'False')"/>
    </data>
</odoo>
